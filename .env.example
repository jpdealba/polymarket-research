# Ejemplo de configuracion de entorno para pmresearch (pmr).
#
# NOTA: pmr lee las variables directamente de os.environ; NO carga este .env
# automaticamente. Usa este archivo como referencia y exporta las variables
# en tu shell, o persistelas con `setx VAR "valor"` (Windows) para que las
# tomen las terminales nuevas.

# Directorio raiz de datos persistentes (db/, raw/, backups/, exports/, logs/).
PMR_DATA_DIR=/data

# Nivel de logging.
PMR_LOG_LEVEL=INFO

# Umbral de "dust": holdings con |cantidad| <= se consideran planos.
PMR_DUST_EPSILON=0.000001

# Fase 11 — Endpoint del subgraph de orderbook de Goldsky (maker/taker/fee).
# Endpoint publico de Polymarket verificado respondiendo (2026-07). Es un
# endpoint publico sin versionar y puede degradarse (ADR 0001); la ruta RPC es
# el fallback documentado. Vacio = subgraph no configurado y `pmr enrich run`
# da error claro.
PMR_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cl6mb8i9h0003e201j6li0diw/subgraphs/orderbook-subgraph/prod/gn

# Fase 11 — URL JSON-RPC de Polygon para cerrar la brecha reciente que el
# subgraph aun no indexo (eth_getLogs de OrderFilled). Vacio = RPC apagado.
# `pmr enrich run --source rpc` trocea el rango en chunks (--chunk-blocks, default
# 2000) y se auto-reduce si el proveedor limita la respuesta, asi que funciona en
# tiers gratis. Opciones gratis:
#   - Alchemy (recomendado, mejor getLogs): https://polygon-mainnet.g.alchemy.com/v2/<API_KEY>
#   - Sin registro (limites mas duros, usa --chunk-blocks 500): https://polygon-bor-rpc.publicnode.com
PMR_RPC_URL=

# Remote de rclone para backup/sync externo opcional.
PMR_RCLONE_REMOTE=
